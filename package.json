{
    "name": "@compean/core",
    "version": "0.1.0",
    "description": "Shared core for Compean apps: controllers, services, errors, forms and the framework rules.",
    "type": "module",
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": ">=22.12"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CompeanR/compean-core.git"
    },
    "files": [
        "dist",
        "RULES.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "default": "./dist/react/index.js"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "default": "./dist/server/index.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "default": "./dist/testing/index.js"
        },
        "./eslint": {
            "types": "./dist/eslint/index.d.ts",
            "default": "./dist/eslint/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run"
    },
    "peerDependencies": {
        "@hono/zod-validator": "^0.9.0",
        "@tanstack/query-core": "^5.100.0",
        "eslint": "^10.0.0",
        "hono": "^4.13.0",
        "react": "^19.1.0",
        "zod": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "@hono/zod-validator": {
            "optional": true
        },
        "@tanstack/query-core": {
            "optional": true
        },
        "eslint": {
            "optional": true
        },
        "hono": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@hono/zod-validator": "0.9.1",
        "@tanstack/query-core": "5.104.5",
        "@testing-library/react": "16.3.3",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "eslint": "10.13.0",
        "hono": "4.13.13",
        "jsdom": "30.1.3",
        "react": "19.1.10",
        "react-dom": "19.1.10",
        "typescript": "7.0.2",
        "vitest": "4.1.12",
        "zod": "4.6.7"
    }
}
