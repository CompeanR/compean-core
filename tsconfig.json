{
    "compilerOptions": {
        "target": "es2023",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": [
            "es2023",
            "dom"
        ],
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": false,
        "verbatimModuleSyntax": true,
        "declaration": true,
        "skipLibCheck": true,
        "rootDir": "src",
        "outDir": "dist",
        "types": [
            "node"
        ]
    },
    "include": [
        "src"
    ]
}
